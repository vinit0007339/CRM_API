diff --git a/scripts/platform_integration_tests.py b/scripts/platform_integration_tests.py
new file mode 100644
index 0000000..d508dde
--- /dev/null
+++ b/scripts/platform_integration_tests.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""Run `tests/platform_integration/` — the database-free platform suite.
+
+    python3 scripts/platform_integration_tests.py
+    python3 scripts/platform_integration_tests.py --quiet
+
+WHAT IS IN THERE, AND WHY IT IS NOT IN `tests/`. One file:
+`test_p2_contact_scope.py`, 25 tests of THIS repo's `ContactCrud` and
+`api/services/contact_scope.py`. It was written during the CRM work and lived
+in `tests/crm_integration/`, which moved to `crm-service-api` — but it tests
+the platform, not the CRM, so it stayed here and brought the harness with it.
+
+⚠️ IT NEEDS A PROCESS OF ITS OWN, AND THAT IS NOT TIDINESS. The harness runs
+without a database by SHADOWING `motor`, `beanie`, `pymongo` and `bson` with
+the fakes in `tests/platform_integration/shims/`. Putting that directory on
+`sys.path` from a `conftest.py` would shadow them for every other test in the
+same pytest session — the rest of `tests/` would then run against fake drivers
+and pass for the wrong reason, or fail for a reason that has nothing to do with
+the code under test. So this script spawns a subprocess with the path set, and
+`pytest tests/` never collects the directory.
+
+That is also why `tests/platform_integration/` has NO `__init__.py`: the
+harness is imported as a top-level `harness`, which only works while the
+directory itself is on the path and is not a package. Adding one makes the
+suite error at collection with `ModuleNotFoundError: No module named
+'harness'` — ten minutes to diagnose, so it is written down here.
+
+⚠️ cwd AND PYTHONPATH BOTH MATTER. Run `unittest discover` on this directory
+from the repo root and it discovers nothing and exits 0 — a green run that
+tested nothing. Hence both are set below.
+"""
+from __future__ import annotations
+
+import argparse
+import configparser
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+SUITE_DIR = ROOT / "tests" / "platform_integration"
+CONFIG = ROOT / "config" / "app.conf"
+
+#: A drop here is a deleted test. Update it in the same commit that changes it.
+EXPECTED = 25
+
+
+def check_config() -> None:
+    """Fail on the real cause, not on a configparser traceback 40 frames in.
+
+    ⚠️ THE MISSING-TEST COUNT BELOW WILL LIE ABOUT THIS IF YOU LET IT. The
+    harness imports `api.dependencies.context`, which imports `app`, which
+    reads `config/app.conf` at module scope. The file is GITIGNORED, so a
+    fresh clone or a git worktree does not have it, and the suite then fails
+    to IMPORT — one collection error, `Ran 1 test`, and this script reports
+    "24 tests have gone missing". That is a wrong diagnosis of a right
+    failure, and it cost real time on the CRM suites before this check
+    existed. Check the file first and say what is actually wrong.
+    """
+    if not CONFIG.exists():
+        print(f"✗ {CONFIG.relative_to(ROOT)} is missing.\n"
+              f"  It is GITIGNORED, so a fresh clone or a git worktree does "
+              f"not have it. Copy it from a working checkout. Without it the "
+              f"app bootstrap raises NoSectionError: No section: 'MAIN', "
+              f"which does not mention the file at all.", file=sys.stderr)
+        sys.exit(1)
+    parser = configparser.ConfigParser()
+    try:
+        parser.read(CONFIG)
+    except configparser.Error as ex:
+        print(f"✗ {CONFIG.relative_to(ROOT)} could not be parsed: {ex}",
+              file=sys.stderr)
+        sys.exit(1)
+    if not parser.has_section("MAIN"):
+        print(f"✗ {CONFIG.relative_to(ROOT)} has no [MAIN] section.\n"
+              f"  That is the section the app bootstrap reads first; a "
+              f"truncated or partially copied config fails here.",
+              file=sys.stderr)
+        sys.exit(1)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quiet", action="store_true",
+                        help="Count only, no failure detail")
+    args = parser.parse_args()
+
+    check_config()
+
+    if not SUITE_DIR.is_dir():
+        print(f"✗ {SUITE_DIR} does not exist", file=sys.stderr)
+        return 1
+    if (SUITE_DIR / "__init__.py").exists():
+        # Guarding the trap rather than only documenting it: the failure it
+        # produces does not point at its own cause.
+        print(f"✗ {SUITE_DIR}/__init__.py exists — the harness is imported as "
+              f"a top-level module and cannot be, while this directory is a "
+              f"package. Delete it.", file=sys.stderr)
+        return 1
+
+    env = dict(os.environ)
+    env["PYTHONPATH"] = os.pathsep.join(
+        [str(SUITE_DIR / "shims"), str(SUITE_DIR), str(ROOT)]
+        + ([env["PYTHONPATH"]] if env.get("PYTHONPATH") else [])
+    )
+    result = subprocess.run(
+        [sys.executable, "-m", "unittest", "discover", "-p", "test_*.py"],
+        cwd=SUITE_DIR, env=env, capture_output=True, text=True, check=False,
+    )
+    text = (result.stdout or "") + (result.stderr or "")
+    match = re.search(r"^Ran (\d+) tests?", text, re.MULTILINE)
+    ran = int(match.group(1)) if match else 0
+    failures = len(re.findall(r"^(FAIL|ERROR): ", text, re.MULTILINE))
+
+    if ran < EXPECTED:
+        # ⚠️ FEWER TESTS THAN EXPECTED IS A FAILURE, not a warning. A warning
+        # that still prints PASS gets rationalised as a stale constant, which
+        # is exactly how a deleted test goes unnoticed.
+        print(f"✗ platform_integration: ran {ran}, expected {EXPECTED} — "
+              f"{EXPECTED - ran} test(s) have gone missing")
+        if not args.quiet:
+            print(text)
+        return 1
+    if ran > EXPECTED:
+        print(f"· platform_integration: ran {ran}, expected {EXPECTED} — "
+              f"update EXPECTED in this script")
+    if failures or result.returncode != 0:
+        print(f"✗ platform_integration: ran {ran}, {failures} failed")
+        if not args.quiet:
